# ── Google AI (MANDATORY for the hackathon) ────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ⚠️ Verify the current Flash model ID in AI Studio before the demo.
GEMINI_MODEL=gemini-2.5-flash

# ── Telephony ──────────────────────────────────────────────────────────────
# simulator (default, no number needed) | exotel | twilio
TELEPHONY_PROVIDER=simulator

# ── Privacy (DPDP Act 2023) ────────────────────────────────────────────────
# Phone numbers are hashed at the boundary with this salt. Change it per deploy.
MSISDN_HASH_SALT=change-me-per-deployment

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8000
