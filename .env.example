# ── Google AI (MANDATORY for the hackathon) ────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ⚠️ Verify the current Flash model ID in AI Studio before the demo.
GEMINI_MODEL=gemini-2.5-flash

# ── Telephony ──────────────────────────────────────────────────────────────
# simulator (default, no number needed) | exotel | twilio
TELEPHONY_PROVIDER=simulator

# ── Privacy (DPDP Act 2023) ────────────────────────────────────────────────
# Phone numbers are hashed at the boundary with this salt. Change it per deploy.
MSISDN_HASH_SALT=change-me-per-deployment

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8000

# ── Speech-to-Text (Person 1, Day 1) ──────────────────────────────────────
# Tried in this order; the first one configured wins. None configured = voice
# intake simply doesn't transcribe, and the rest of the system keeps working.
STT_CHAIN=sarvam,bhashini,gemini,google

# 1 · Sarvam AI — fastest signup, simple REST, 22 Indic languages
#    Dashboard: https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
SARVAM_MODE=transcribe        # transcribe | translate | verbatim | translit | codemix

# 2 · Bhashini — free, Government of India. Best story for a DPI pitch.
#    Register: https://meity-auth.ulca.ai  → create an app → copy the 3 values below
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=

# 3 · Google Cloud Speech-to-Text (Chirp_2) — best accuracy, needs a GCP project
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_STT_MODEL=chirp_2
